---
title: "AI quota: one caller across a UTC midnight"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Over the daily limit
    lg1: Within the daily limit
    lg2: Breaks UidWithinDailyLimit
    lg3: Path to the UidWithinDailyLimit bug
  }
  class lg0 orange
  class lg1 blue
  class lg2 breaks
  class lg3 bugPath
  state "Day 1" as s0 {
    s1: Guest #183; answers: 0
    s2: Guest #183; answers: 0 #183; 1 in flight
    s3: Guest #183; answers: 0 #183; 2 in flight
    s4: Guest #183; answers: 1 #183; 1 in flight
    s5: Guest, data deleted #183; answers: 1 #183; counter says 0 #183; 1 in flight
    s6: Guest, data deleted #183; answers: 1 #183; counter says 1 #183; 1 in flight
    s7: Guest, data deleted #183; answers: 2 #183; counter says 1
  }
  [*] --> s1
  s1 --> s2: the app asks the AI
  s2 --> s3: the app asks the AI
  s3 --> s3: the server checks and counts the quota
  s3 --> s4: the AI provider answers or fails (no refund)
  s4 --> s5: the user deletes the account (token still valid)
  s5 --> s6: the server checks and counts the quota
  s6 --> s7: the AI provider answers or fails (no refund)
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s1 blue
  class s1 bugPath
  class s2 blue
  class s2 bugPath
  class s3 blue
  class s3 bugPath
  class s4 blue
  class s4 bugPath
  class s5 blue
  class s5 bugPath
  class s6 blue
  class s6 bugPath
  class s7 orange
  class s7 breaks
  class s7 bugPath
