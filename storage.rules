rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ImageService.uploadImage always sends JPEG. Refusing every other type keeps out SVG, which
    // can carry script.
    function isOwnJpegUpload(userId) {
      return request.auth != null
             && request.auth.uid == userId
             && request.resource.size < 5 * 1024 * 1024
             && request.resource.contentType == 'image/jpeg';
    }

    // Answer images: each user owns their own answer media. Shared question
    // previews should go through app/backend-controlled URLs, not broad bucket reads.
    // ImageService names them slot_0.jpg to slot_2.jpg, so a user holds at most three per question.
    match /answers/{userId}/{questionId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isOwnJpegUpload(userId)
                            && questionId.size() <= 128
                            && fileName.matches('^slot_[0-2]\\.jpg$');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Profile images: each user owns one profile photo, at ImageService.profileImagePath.
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isOwnJpegUpload(userId)
                            && fileName == 'profile.jpg';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
