{
  "name": "ttb-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "lint": "echo 'No lint configured'",
    "test": "node --test",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test:rules": "firebase emulators:exec --project demo-ttb-rules --only firestore,storage \"node --test rules-emulator/securityRules.spec.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.13.6"
    },
    "uuid": "^11.1.1"
  }
}
